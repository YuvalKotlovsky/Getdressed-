# Copy to .env (git-ignored). Never commit real values.

# --- Supabase (client-safe: these two ship inside the app, build time) ---
# Project URL and the PUBLIC anon/publishable key only. The app refuses a service-role / sb_secret_ key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Recognition server ---
# Public URL of the recognition server (not a secret). Used at build time by the app:
EXPO_PUBLIC_RECOGNITION_URL=
# Server only (never put in the app):
ANTHROPIC_API_KEY=

# --- RLS verification script (scripts/verify-rls.ts; dev project only, never production) ---
# Two pre-created, email-verified test accounts. Uses the anon key only; no service-role key is needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
