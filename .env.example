# Copy to .env (git-ignored). Never commit real values.

# --- Supabase (client-safe: these two ship inside the app, build time) ---
# Project URL and the PUBLIC anon/publishable key only. The app refuses a service-role / sb_secret_ key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Recognition server ---
# Public URL of the recognition server (not a secret). Used at build time by the app:
EXPO_PUBLIC_RECOGNITION_URL=
# Server only (never put in the app). Authenticated photo analysis (server/index.ts):
#   SUPABASE_URL / SUPABASE_ANON_KEY (PUBLIC key; the server refuses secret/service keys), GEMINI_API_KEY, GEMINI_MODEL,
#   ALLOWED_ORIGIN, TRUST_PROXY_HOPS. Quota limits live in the database (ai_quota_limits), not here. See server/README.md.
GEMINI_API_KEY=
# Legacy unauthenticated routes (local experiments only, ignored when NODE_ENV=production): ALLOW_LEGACY_UNAUTHENTICATED=1
ANTHROPIC_API_KEY=

# --- RLS verification (scripts/verify-rls.ts) ---
# Put these in a SEPARATE git-ignored file `.env.verify` (never in `.env`, which the app build reads), then: npm run verify:rls
# DEVELOPMENT project only. Two pre-created, email-verified synthetic accounts. Anon key only; no service-role key.
EXPECT_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
